<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Culinary_Guide.Views.RestaurantDetailPage"
             BackgroundColor="{StaticResource Background}"
             Title="">
    
    <ScrollView>
        <Grid RowDefinitions="200,Auto,Auto,Auto,Auto,Auto,*" Padding="0">
            
            <!-- 顶部图片轮播 -->
            <CarouselView Grid.Row="0"
                          x:Name="ImageCarousel"
                          Position="0"
                          HeightRequest="200"
                          IndicatorView="Indicator">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding .}"
                               Aspect="AspectFill" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <IndicatorView Grid.Row="0"
                           x:Name="Indicator"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,10"
                           IndicatorColor="White"
                           SelectedIndicatorColor="{StaticResource Primary}" />
            
            <!-- 返回按钮 -->
            <Border Grid.Row="0"
                    Margin="10"
                    Padding="10"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource TextPrimary}" />
            </Border>
            
            <!-- 餐厅信息 -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="16"
                                 Spacing="12">
                <!-- 名称 + 收藏 -->
                <HorizontalStackLayout HorizontalOptions="StartAndExpand">
                    <Label Text="{Binding Name}"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="StartAndExpand" />
                    <Border x:Name="FavoriteBorder"
                            Padding="10"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="White"
                            Stroke="{StaticResource Primary}"
                            Margin="8,0,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoriteClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="FavoriteIcon"
                               Text="🤍"
                               FontSize="24" />
                    </Border>
                </HorizontalStackLayout>
                
                <!-- 评分 + 菜系 + 距离 -->
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="{StaticResource Rating}"
                            Padding="10,6"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                   TextColor="#5D4037"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="#E8F5E9"
                            Padding="10,6"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent">
                        <Label Text="{Binding CuisineType}"
                               TextColor="#2E7D32"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Border>
                    <Border BackgroundColor="{StaticResource Distance}"
                            Padding="10,6"
                            StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding Distance, StringFormat='{0:F1}km'}"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
                
                <!-- 评价数 -->
                <Label Text="{Binding ReviewCount, StringFormat='{0} 条评价'}"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="14" />
            </VerticalStackLayout>
            
            <!-- 地址/电话/营业时间 -->
            <Border Grid.Row="2"
                    Margin="16,0,16,16"
                    Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📍" FontSize="18" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="地址"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Address}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    
                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />
                    
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📞" FontSize="18" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="电话"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Phone}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    
                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}"
                             HorizontalOptions="Fill" />
                    
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⏰" FontSize="18" VerticalOptions="Center" />
                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="营业时间"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding OpeningHours}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            
            <!-- 简介 -->
            <Border Grid.Row="3"
                    Margin="16,0,16,16"
                    Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📝 简介"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{Binding Description}"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="14"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
            
            <!-- 用户评价 -->
            <Border Grid.Row="4"
                    Margin="16,0,16,16"
                    Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="12">
                    <Label Text="💬 用户评价"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{StaticResource TextPrimary}" />
                    
                    <CollectionView x:Name="ReviewsList"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#FAFAFA"
                                        Stroke="Transparent">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout HorizontalOptions="StartAndExpand">
                                            <Label Text="{Binding UserName}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   HorizontalOptions="StartAndExpand" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="⭐" FontSize="12" VerticalOptions="Center" />
                                                <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                                       TextColor="{StaticResource Rating}"
                                                       FontSize="12"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                        
                                        <Label Text="{Binding Comment}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="14"
                                               LineBreakMode="WordWrap" />
                                        
                                        <HorizontalStackLayout Spacing="16">
                                            <Label Text="{Binding CreatedAt, StringFormat='{0:MM-dd HH:mm}'}"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   FontSize="12" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="❤️" FontSize="12" VerticalOptions="Center" />
                                                <Label Text="{Binding LikeCount}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="12">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer BindingContext="{Binding .}"
                                                                              Tapped="OnLikeReview" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                        
                                        <!-- 回复列表 -->
                                        <VerticalStackLayout Spacing="8"
                                                             Margin="0,8,0,0">
                                            <CollectionView ItemsSource="{Binding Replies}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,4,0,0"
                                                                Padding="10"
                                                                StrokeShape="RoundRectangle 8"
                                                                BackgroundColor="#F0F0F0"
                                                                Stroke="Transparent">
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding UserName}"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{StaticResource TextPrimary}" />
                                                                <Label Text="{Binding Content}"
                                                                       FontSize="12"
                                                                       TextColor="{StaticResource TextSecondary}" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            
            <!-- 发表评论按钮 -->
            <Border Grid.Row="5"
                    Margin="16,0,16,16"
                    Padding="0"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{StaticResource Primary}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnWriteReviewClicked" />
                </Border.GestureRecognizers>
                <Label Text="✍️ 写评价"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,12" />
            </Border>
            
            <!-- 底部占位 -->
            <BoxView Grid.Row="6" HeightRequest="20" />
        </Grid>
    </ScrollView>
</ContentPage>
