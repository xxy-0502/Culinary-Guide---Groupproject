<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Culinary_Guide.Helpers"
             x:Class="Culinary_Guide.Views.NotificationsPage"
             BackgroundColor="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="16,16,16,0">
        
        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0"
              HeightRequest="56"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,0,0,8">
            
            <!-- 左侧：返回按钮 -->
            <Border Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       FontSize="24"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <!-- 中间：标题 -->
            <Label Grid.Column="1"
                   Text="{Binding NotificationsTitle}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            
            <!-- 右侧：占位 -->
            <Border Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    Stroke="Transparent" />
        </Grid>
        
        <!-- 通知列表 -->
        <CollectionView Grid.Row="1"
                        x:Name="NotificationsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="16"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="Transparent">
                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto">
                            
                            <!-- 图标 -->
                            <Label Grid.RowSpan="2"
                                   Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontSize="24"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0" />
                            
                            <!-- 标题 -->
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            
                            <!-- 内容 -->
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Content}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="16">
                    <Label Text="🔔"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding NoNotifications}"
                           FontSize="18"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        
        <!-- 底部导航栏 -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="0"
                HeightRequest="70"
                Stroke="Transparent">
            <Grid ColumnDefinitions="*,*,*">
                
                <!-- 收藏 Tab -->
                <Grid Grid.Column="0" 
                      x:Name="FavoritesTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritesTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="❤️" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                        <Label Text="{Binding TabFavorites}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                    </VerticalStackLayout>
                </Grid>
                
                <!-- 首页 Tab -->
                <Grid Grid.Column="1" 
                      x:Name="HomeTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🏠" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                        <Label Text="{Binding TabHome}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                    </VerticalStackLayout>
                </Grid>
                
                <!-- 探索 Tab -->
                <Grid Grid.Column="2" 
                      x:Name="ExploreTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🗺️" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                        <Label Text="{Binding TabExplore}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                    </VerticalStackLayout>
                </Grid>
                
            </Grid>
        </Border>
    </Grid>
</ContentPage>