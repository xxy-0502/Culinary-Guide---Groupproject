<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Culinary_Guide.Helpers"
             x:Class="Culinary_Guide.Views.FavoritesPage"
             BackgroundColor="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="16,16,16,0">
        
        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0"
              HeightRequest="56"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,0,0,8">
            
            <!-- 左侧：返回按钮 -->
            <Border Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       FontSize="24"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <!-- 中间：标题 -->
            <Label Grid.Column="1"
                   Text="{Binding FavoritesTitle, StringFormat='❤️ {0}'}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            
            <!-- 右侧：占位 -->
            <Border Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    Stroke="Transparent" />
        </Grid>
        
        <!-- 收藏列表 -->
        <CollectionView Grid.Row="1"
                        x:Name="FavoritesList"
                        SelectionMode="Single"
                        SelectionChanged="OnRestaurantSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,16"
                            Padding="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            BackgroundColor="{StaticResource CardBackground}">
                        <Grid RowDefinitions="160,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto">
                            
                            <!-- 餐厅图片 -->
                            <Image Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Source="{Binding ImageUrls[0]}"
                                   Aspect="AspectFill"
                                   HeightRequest="160" />
                            
                            <!-- 收藏按钮 -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10"
                                    Padding="8"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFavoriteClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="❤️"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            
                            <!-- 餐厅名称 + 评分 -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="16,12,16,8">
                                <HorizontalStackLayout HorizontalOptions="StartAndExpand">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalOptions="StartAndExpand" />
                                    <Border BackgroundColor="{StaticResource Rating}"
                                            Padding="8,4"
                                            StrokeShape="RoundRectangle 12"
                                            Margin="8,0,0,0">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⭐" FontSize="12" />
                                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                                   TextColor="#5D4037"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                                
                                <!-- 菜系标签 -->
                                <Border BackgroundColor="#E8F5E9"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 8"
                                        Margin="0,8,0,0"
                                        HorizontalOptions="Start"
                                        Stroke="Transparent">
                                    <Label Text="{Binding CuisineType}"
                                           TextColor="#2E7D32"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            
                            <!-- 距离 -->
                            <HorizontalStackLayout Grid.Row="2"
                                                   Padding="16,0,16,8"
                                                   Spacing="8">
                                <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                                <Label Text="{Binding Distance, StringFormat='{0:F1}km'}"
                                       TextColor="{StaticResource Distance}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            
                            <!-- 评价数 -->
                            <Label Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Padding="16,0,16,12"
                                   Text="{Binding ReviewCount, StringFormat='{0} 条评价 · 点击查看'}"
                                   TextColor="{StaticResource Favorite}"
                                   FontSize="12" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <!-- 空状态提示 -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="16">
                    <Label Text="💔"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding NoFavorites}"
                           FontSize="18"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding GoDiscover}"
                           FontSize="14"
                           TextColor="{StaticResource Distance}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        
        <!-- 底部导航栏 -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="0"
                HeightRequest="70"
                Stroke="Transparent">
            <Grid ColumnDefinitions="*,*,*">
                
                <!-- 收藏 Tab (当前选中) -->
                <Grid Grid.Column="0" 
                      x:Name="FavoritesTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritesTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="❤️" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#000000" />
                        <Label Text="{Binding TabFavorites}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#000000" />
                    </VerticalStackLayout>
                </Grid>
                
                <!-- 首页 Tab -->
                <Grid Grid.Column="1" 
                      x:Name="HomeTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🏠" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                        <Label Text="{Binding TabHome}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                    </VerticalStackLayout>
                </Grid>
                
                <!-- 探索 Tab -->
                <Grid Grid.Column="2" 
                      x:Name="ExploreTab"
                      HorizontalOptions="Center" 
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTabClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🗺️" 
                               FontSize="24" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                        <Label Text="{Binding TabExplore}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="#80000000" />
                    </VerticalStackLayout>
                </Grid>
                
            </Grid>
        </Border>
    </Grid>
</ContentPage>