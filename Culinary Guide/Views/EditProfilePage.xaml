<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Culinary_Guide.Helpers"
             x:Class="Culinary_Guide.Views.EditProfilePage"
             BackgroundColor="{StaticResource Background}"
             NavigationPage.HasNavigationBar="False">
    
    <ContentPage.BindingContext>
        <helpers:Localize x:Name="Loc" />
    </ContentPage.BindingContext>
    
    <Grid RowDefinitions="Auto,*" Padding="16,16,16,0">
        
        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0"
              HeightRequest="56"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,0,0,8">
            
            <!-- 左侧：返回按钮 -->
            <Border Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       FontSize="24"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <!-- 中间：标题 -->
            <Label Grid.Column="1"
                   Text="{Binding EditProfile}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            
            <!-- 右侧：占位 -->
            <Border Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    Stroke="Transparent" />
        </Grid>
        
        <!-- 主要内容 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24">
                
                <!-- 头像区域 -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="100"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 50"
                            BackgroundColor="{StaticResource Primary}"
                            Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAvatarClicked" />
                        </Border.GestureRecognizers>
                        <Image x:Name="AvatarImage"
                               Source="user.png"
                               Aspect="AspectFill"
                               IsVisible="False" />
                        <Label x:Name="AvatarPlaceholder"
                               Text="👤"
                               FontSize="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    
                    <Label Text="{Binding TapToChangeAvatar}"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                <!-- 表单区域 -->
                <Border BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        Stroke="Transparent">
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- 昵称 -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Nickname}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry x:Name="NicknameEntry"
                                   Placeholder="{Binding NicknamePlaceholder}"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="Transparent"
                                   MaxLength="20" />
                        </VerticalStackLayout>
                        
                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />
                        
                        <!-- 简介 -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Bio}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Editor x:Name="BioEditor"
                                    Placeholder="{Binding BioPlaceholder}"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    HeightRequest="80"
                                    MaxLength="200" />
                        </VerticalStackLayout>
                        
                    </VerticalStackLayout>
                </Border>
                
                <!-- 保存按钮 -->
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 24"
                        Padding="0"
                        HeightRequest="50"
                        Stroke="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding Save}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>