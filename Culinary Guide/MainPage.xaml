<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Culinary_Guide.MainPage"
             BackgroundColor="{StaticResource Background}"
             Title="🍴 美食地图">
    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16">
        
        <!-- 欢迎语 + 定位 -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="今天吃什么呢？"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
            <Border BackgroundColor="{StaticResource Secondary}"
                    Padding="12,8"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="📍" FontSize="16" />
                    <Label Text="北京国贸"
                           TextColor="#2E7D32"
                           FontSize="14" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
        
        <!-- 搜索框 -->
        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Padding="0"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent"
                BackgroundColor="{StaticResource CardBackground}">
                    <SearchBar x:Name="SearchBar"
                               Placeholder="🔍 搜索餐厅或菜系..."
                               BackgroundColor="{StaticResource CardBackground}"
                               SearchButtonPressed="OnSearch" />
        </Border>
        
        <!-- 排序按钮组 -->
        <HorizontalStackLayout Grid.Row="2"
                               Spacing="12"
                               Margin="0,0,0,12">
            <Border x:Name="DistanceBtn"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="16,10"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDistanceSort" />
                </Border.GestureRecognizers>
                <Label Text="📍 距离"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <Border x:Name="RatingBtn"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="16,10"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRatingSort" />
                </Border.GestureRecognizers>
                <Label Text="⭐ 评分"
                       TextColor="{StaticResource Primary}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <Border x:Name="ReviewsBtn"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="16,10"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReviewsSort" />
                </Border.GestureRecognizers>
                <Label Text="🔥 热门"
                       TextColor="{StaticResource Primary}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>
        
        <!-- 餐厅列表 -->
        <CollectionView Grid.Row="3"
                        x:Name="RestaurantList"
                        SelectionMode="None"
                        Margin="0,-10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,16"
                            Padding="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            BackgroundColor="{StaticResource CardBackground}">
                        <Grid RowDefinitions="160,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto">
                            
                            <!-- 餐厅图片 -->
                            <Image Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Source="{Binding ImageUrls[0]}"
                                   Aspect="AspectFill"
                                   HeightRequest="160">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer BindingContext="{Binding .}" Tapped="OnRestaurantClicked" />
                                </Image.GestureRecognizers>
                            </Image>
                            
                            <!-- 收藏按钮 -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10"
                                    Padding="8"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFavoriteClicked" />
                                </Border.GestureRecognizers>
                                <Label x:Name="FavoriteIcon"
                                       Text="🤍"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            
                            <!-- 餐厅名称 + 评分 -->
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="16,12,16,8">
                                <HorizontalStackLayout HorizontalOptions="StartAndExpand">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalOptions="StartAndExpand" />
                                    <Border BackgroundColor="{StaticResource Rating}"
                                            Padding="8,4"
                                            StrokeShape="RoundRectangle 12"
                                            Margin="8,0,0,0">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⭐" FontSize="12" />
                                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                                   TextColor="#5D4037"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                                
                                <!-- 菜系标签 -->
                                <Border BackgroundColor="#E8F5E9"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 8"
                                        Margin="0,8,0,0"
                                        HorizontalOptions="Start"
                                        Stroke="Transparent">
                                    <Label Text="{Binding CuisineType}"
                                           TextColor="#2E7D32"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            
                            <!-- 距离 -->
                            <HorizontalStackLayout Grid.Row="2"
                                                   Padding="16,0,16,8"
                                                   Spacing="8">
                                <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                                <Label Text="{Binding Distance, StringFormat='{0:F1}km'}"
                                       TextColor="{StaticResource Distance}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            
                            <!-- 评价数 -->
                            <Label Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Padding="16,0,16,12"
                                   Text="{Binding ReviewCount, StringFormat='{0} 条评价 · 点击查看'}"
                                   TextColor="{StaticResource Favorite}"
                                   FontSize="12" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
